# --- Signaling server ---
PORT=8080

# Optional TURN server for reliable NAT traversal on mobile networks.
# STUN alone (Google's public servers) is used by default; add TURN for symmetric NAT.
# These are injected into the client config served at /config.js
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Case generator (tools/generate-case.js) ---
# Claude generates the mystery (story, clues, solution) as structured JSON.
ANTHROPIC_API_KEY=

# Gemini generates the art for each clue/suspect prompt.
GEMINI_API_KEY=

# Which image provider the generator uses: "gemini" or "placeholder"
IMAGE_PROVIDER=gemini
